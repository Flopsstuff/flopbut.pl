---
import { Image } from 'astro:assets';
import type { Locale } from '../config.ts';
import { crew } from '../data/crew.ts';
import { portraitOf } from '../data/portraits.ts';
import { agentsAddresses, useTranslations } from '../i18n/utils.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const agents = crew.filter((member) => !member.human);
const href = agentsAddresses()[locale];
---

<section class="section" aria-labelledby="crew-title">
  <div class="page">
    <div class="section-head">
      <p class="label">{t.crew.eyebrow}</p>
      <h2 class="section-title" id="crew-title">{t.crew.title}</h2>
      <p class="prose">{t.crew.body}</p>
    </div>

    {/* The roster moved to its own page on agents.flopbut.pl; here the fleet is a row of faces. */}
    <a class="crew-link" href={href}>
      <span class="faces" aria-hidden="true">
        {
          agents.map((member, index) => (
            <Image
              class="face"
              src={portraitOf(member.name)}
              alt=""
              width={96}
              height={96}
              style={`--i: ${index}`}
            />
          ))
        }
      </span>
      <span class="crew-cta">
        <span class="crew-cta-text">{t.crew.cta}</span>
        <span class="crew-arrow" aria-hidden="true">→</span>
      </span>
      <span class="label crew-host">agents.flopbut.pl</span>
    </a>

    <p class="punchline">{t.crew.punchline}</p>
    <p class="prose human-part">{t.crew.humanPart}</p>
  </div>
</section>

<style>
  .crew-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'faces faces'
      'cta   host';
    align-items: baseline;
    gap: 1.25rem 1.5rem;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .crew-link:hover {
    border-color: var(--patina);
    background-color: var(--surface);
  }

  /* Overlapping like a stack of badges; each face is ringed in the page colour so they separate. */
  .faces {
    grid-area: faces;
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.5rem;
    padding-left: 0.6rem;
  }

  .face {
    display: block;
    width: clamp(2.5rem, 2rem + 2vw, 3rem);
    height: clamp(2.5rem, 2rem + 2vw, 3rem);
    margin-left: -0.6rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    object-fit: cover;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
    transition-delay: calc(var(--i) * 18ms);
  }

  .crew-link:hover .face {
    border-color: var(--surface);
    transform: translateY(-3px);
  }

  .crew-cta {
    grid-area: cta;
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .crew-cta-text {
    font-family: var(--font-display), var(--font-fallback-sans);
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .crew-arrow {
    font-size: var(--step-3);
    color: var(--patina);
    transition: transform 0.2s ease;
  }

  .crew-link:hover .crew-arrow {
    transform: translateX(0.35rem);
  }

  .crew-host {
    grid-area: host;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  @media (max-width: 34rem) {
    .crew-link {
      grid-template-columns: 1fr;
      grid-template-areas:
        'faces'
        'cta'
        'host';
      gap: 1rem;
    }
  }

  .punchline {
    max-width: 42ch;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    font-family: var(--font-display), var(--font-fallback-sans);
    font-size: var(--step-2);
    line-height: 1.25;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .human-part {
    margin-top: 1.25rem;
  }
</style>
