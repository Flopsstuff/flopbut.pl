---
import { LINKS, type Locale, SITE_URL } from '../config.ts';
import { agentsAddresses, alternateLinks, localizedPath, useTranslations } from '../i18n/utils.ts';

interface Props {
  locale: Locale;
  /** Error pages: switch to each locale's home, since the current path has no translations. */
  toHome?: boolean;
  /**
   * Set on the crew page, which is served from agents.flopbut.pl: the language switcher
   * goes to these addresses, and the site links become absolute so they leave the subdomain.
   */
  addresses?: Record<Locale, string>;
}

const { locale, toHome = false, addresses } = Astro.props;
const t = useTranslations(locale);
const site = addresses ? SITE_URL : '';
const alternates = alternateLinks(locale, toHome ? new URL('/', Astro.url) : Astro.url).map(
  (alt) => ({ ...alt, href: addresses?.[alt.locale] ?? alt.path }),
);
const wallPath = localizedPath(locale, '/wall/');
const onWall = Astro.url.pathname === wallPath;
/* The crew page is the only one served from agents.flopbut.pl, so `addresses` marks it. */
const onAgents = addresses !== undefined;
---

<header class="header">
  <div class="page header-inner">
    <nav class="brand" aria-label="flopbut.pl">
      <a class="wordmark" href={`${site}${localizedPath(locale, '/')}`}>
        {/*
          The mark from public/favicon.svg in its inverted treatment, ink letters on a patina
          plate, so it reads on both themes. Brand values, not theme tokens: the light theme
          darkens --patina for text, and a logo keeps #5fb79b.
        */}
        <svg class="mark" viewBox="0 0 32 32" width="20" height="20" aria-hidden="true">
          <rect width="32" height="32" rx="5" fill="#5fb79b"></rect>
          <g fill="#0b1312">
            <path d="M9 12h9v3.4H9z"></path>
            <path d="M11.8 12.6h3.4V26h-3.4z"></path>
            <path d="M11.8 10.5c0-2.6 1.6-4.3 4.2-4.3h2.2v3.3h-1.8c-.9 0-1.2.5-1.2 1.3v1.7h-3.4z"></path>
            <path d="M19.6 6h3.4v20h-3.4z"></path>
            <path d="M22 13.4h1.6a6.3 6.3 0 0 1 0 12.6H22v-3.3h1.5a3 3 0 0 0 0-6H22z"></path>
          </g>
        </svg>
        <span class="wordmark-text">flopbut.pl</span>
      </a>
      <a
        class:list={['nav-link', { 'nav-current': onAgents }]}
        href={agentsAddresses()[locale]}
        aria-current={onAgents ? 'page' : undefined}
      >
        {t.nav.agents}
      </a>
      <a
        class:list={['nav-link', { 'nav-current': onWall }]}
        href={`${site}${wallPath}`}
        aria-current={onWall ? 'page' : undefined}
      >
        {t.nav.wall}
      </a>
      <a class="nav-link" href={LINKS.projects}>{t.nav.projects}</a>
    </nav>

    <div class="controls">
      <nav class="langs" aria-label={t.nav.language}>
        {
          alternates.map(({ locale: alt, href, isCurrent, label }) => (
            <a
              href={href}
              hreflang={alt}
              lang={alt}
              title={label}
              class:list={['lang', { 'lang-current': isCurrent }]}
              aria-current={isCurrent ? 'true' : undefined}
            >
              {alt}
            </a>
          ))
        }
      </nav>

      <button type="button" id="theme-toggle" class="theme-toggle" title={t.nav.theme}>
        <span class="sr-only">{t.nav.theme}</span>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M8 1a7 7 0 0 0 0 14z" fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
  <hr class="rule" />
</header>

<script>
  const toggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    if (next === 'light') {
      root.dataset.theme = 'light';
    } else {
      delete root.dataset.theme;
    }
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* nothing to persist to - the toggle still works for this visit */
    }
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    /* srgb, not oklch: interpolating towards `transparent` in oklch shifts the hue. */
    background-color: color-mix(in srgb, var(--ink) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  /* A hairline that draws in from the left on hover and stays drawn under the current page. */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.3rem;
    height: 1px;
    background-color: var(--patina);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-current::after {
    transform: scaleX(1);
  }

  .nav-current::after {
    background-color: var(--brass);
  }

  .nav-current {
    color: var(--brass);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--text);
    text-decoration: none;
  }

  .mark {
    flex-shrink: 0;
    display: block;
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  /* A small tilt with a little overshoot, the plate nodding back. */
  .wordmark:hover .mark {
    transform: rotate(-8deg) scale(1.08);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .langs {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .lang {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .lang:hover {
    color: var(--text);
  }

  .lang-current {
    color: var(--brass);
  }

  /* Phones: both nav links, three languages and the toggle must all fit beside the wordmark. */
  @media (max-width: 26rem) {
    .header-inner {
      flex-wrap: wrap;
      gap: 0.4rem;
    }

    /* The mark alone carries the home link here; the name stays for screen readers. */
    .wordmark-text {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .brand {
      gap: 0.5rem;
    }

    .controls {
      gap: 0.5rem;
    }

    .langs {
      gap: 0.3rem;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }
</style>
