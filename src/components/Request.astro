---
import { LINKS, type Locale } from '../config.ts';
import { localizedPath, useTranslations } from '../i18n/utils.ts';
import { LIMITS, type RequestView } from '../lib/request-page.ts';
import Footer from './Footer.astro';
import Header from './Header.astro';

/** Pure view. The page decides the state (see src/lib/request-page.ts); this only draws it. */
interface Props {
  locale: Locale;
  view: RequestView;
}

const { locale, view } = Astro.props;
const t = useTranslations(locale);
const wall = localizedPath(locale, '/wall/');
---

<Header locale={locale} />

<main id="main" class="request">
  <div class="page">
    {
      view.state === 'unavailable' && (
        <>
          <h1 class="label heading">{t.request.eyebrow}</h1>
          <p class="lead">{t.request.unavailable.title}</p>
          <p class="prose">{t.request.unavailable.body}</p>
        </>
      )
    }

    {
      view.state === 'signedOut' && (
        <>
          <h1 class="label heading">{t.request.eyebrow}</h1>
          <p class="prose">{t.request.intro}</p>
          <ol class="steps">
            {t.request.steps.map((step) => (
              <li>{step}</li>
            ))}
          </ol>
          <p class="prose">{t.request.freedom}</p>
          {view.error && (
            <p class="error" role="alert">
              {t.request.errors[view.error]}
            </p>
          )}
          <a class="button cta" href={`/api/auth/login?locale=${locale}`}>
            <span>{t.request.signIn}</span>
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>
        </>
      )
    }

    {
      view.state === 'signedIn' && (
        <>
          <h1 class="label heading">{t.request.eyebrow}</h1>

          <div class="identity">
            <img
              class="avatar"
              src={`https://github.com/${view.login}.png?size=64`}
              alt=""
              width="32"
              height="32"
              loading="lazy"
            />
            <p>
              {t.request.signedInAs} <strong>@{view.login}</strong>
            </p>
            <form method="post" action="/api/auth/logout">
              <input type="hidden" name="locale" value={locale} />
              <button class="link-button" type="submit">
                {t.request.signOut}
              </button>
            </form>
          </div>

          {view.error && (
            <p class="error" role="alert">
              {t.request.errors[view.error]}
            </p>
          )}

          <form class="form" method="post" action={localizedPath(locale, '/request/')}>
            <div class="field">
              <label for="text">{t.request.textLabel}</label>
              <p class="hint" id="text-hint">
                {t.request.textHint}
              </p>
              <textarea
                id="text"
                name="text"
                rows="8"
                required
                minlength={LIMITS.text.min}
                maxlength={LIMITS.text.max}
                aria-describedby="text-hint">{view.text}</textarea>
            </div>

            <div class="field">
              <label for="relation">{t.request.relationLabel}</label>
              <p class="hint" id="relation-hint">
                {t.request.relationHint}
              </p>
              <input
                id="relation"
                name="relation"
                type="text"
                maxlength={LIMITS.relation}
                value={view.relation}
                aria-describedby="relation-hint"
              />
            </div>

            <p class="prose notice">{t.request.publicNotice}</p>

            <button class="button" type="submit">
              <span>{t.request.submit}</span>
              <span class="button-arrow" aria-hidden="true">→</span>
            </button>
          </form>
        </>
      )
    }

    {
      view.state === 'sent' && (
        <>
          <p class="label">{t.request.sent.eyebrow}</p>
          <h1 class="title">{t.request.sent.title}</h1>
          <p class="prose">{t.request.sent.body}</p>
          <a class="button cta" href={`${LINKS.repo}/issues/${view.number}`}>
            <span>{t.request.sent.issue}</span>
            <span class="button-arrow" aria-hidden="true">→</span>
          </a>
        </>
      )
    }

    <a class="back" href={wall}>
      <span class="back-arrow" aria-hidden="true">←</span>
      <span>{t.request.back}</span>
    </a>
  </div>
</main>

<Footer locale={locale} />

<style>
  .request {
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }

  .title {
    font-size: var(--step-5);
    margin-block: 1.5rem 1.25rem;
  }

  /* The page's heading is the small label: the wall's button already said what this is. */
  .heading {
    margin: 0 0 1.5rem;
  }

  .cta {
    margin-top: 2.5rem;
  }

  .steps {
    max-width: var(--measure);
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    color: var(--text);
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
  }

  .steps li::before {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    color: var(--patina);
  }

  .error {
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    border-left: 2px solid var(--brass);
    color: var(--text);
    max-width: var(--measure);
  }

  /* ---- signed in ---- */

  .identity {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 2rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    background-color: var(--surface);
    max-width: var(--measure);
  }

  .avatar {
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background-color: var(--surface-raised);
  }

  .identity form {
    margin-left: auto;
  }

  .link-button {
    padding: 0;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    background: none;
    color: var(--muted);
    cursor: pointer;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--step--1);
  }

  .link-button:hover {
    color: var(--text);
    border-bottom-color: var(--patina);
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 2rem;
    max-width: var(--measure);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field label {
    font-family: var(--font-display), var(--font-fallback-sans);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .hint {
    color: var(--muted);
    font-size: var(--step--1);
  }

  textarea,
  input[type='text'] {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background-color: var(--surface);
    color: var(--text);
    font: inherit;
    line-height: 1.5;
  }

  textarea {
    resize: vertical;
    min-height: 10rem;
  }

  textarea:focus-visible,
  input[type='text']:focus-visible {
    outline: none;
    border-color: var(--patina);
  }

  .notice {
    font-size: var(--step--1);
  }

  .form .button {
    align-self: flex-start;
  }

  /* ---- back link ---- */

  .back {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 0.5rem;
    margin-top: 3rem;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: var(--step--1);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }

  .back:hover {
    border-bottom-color: var(--patina);
  }

  .back-arrow {
    color: var(--patina);
  }
</style>
