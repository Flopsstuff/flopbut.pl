---
import type { Locale } from '../config.ts';
import { localizedPath, useTranslations } from '../i18n/utils.ts';
import Footer from './Footer.astro';
import Header from './Header.astro';
import FiveCats from './wall/FiveCats.astro';
import WallEntry from './wall/WallEntry.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Header locale={locale} />

<main id="main" class="wall">
  <div class="page">
    <p class="label">{t.wall.eyebrow}</p>
    <h1 class="title">{t.wall.title}</h1>
    <p class="prose">{t.wall.body}</p>

    <a class="button cta" href={localizedPath(locale, '/request/')}>
      <span>{t.wall.cta}</span>
      <span class="button-arrow" aria-hidden="true">→</span>
    </a>

    {/*
      Oldest first, newest at the bottom, one <WallEntry> per accepted request. A new
      contribution is a component under wall/ plus its strings in the dictionaries; nothing
      already on the wall moves to make room.
    */}
    <ul class="entries">
      <WallEntry locale={locale} author="katyoid" issue={11} date="2026-09-13">
        <FiveCats locale={locale} />
      </WallEntry>
    </ul>
  </div>
</main>

<Footer locale={locale} />

<style>
  .wall {
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }

  .title {
    font-size: var(--step-5);
    margin-block: 1.5rem 1.25rem;
  }

  .cta {
    margin-top: 2.5rem;
  }

  .entries {
    list-style: none;
    margin: clamp(3rem, 2rem + 4vw, 5rem) 0 0;
    padding: 0;
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
</style>
