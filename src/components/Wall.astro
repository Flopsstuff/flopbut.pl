---
import type { Locale } from '../config.ts';
import { localizedPath, useTranslations } from '../i18n/utils.ts';
import Footer from './Footer.astro';
import Header from './Header.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<Header locale={locale} />

<main id="main" class="wall">
  <div class="page">
    <p class="label">{t.wall.eyebrow}</p>
    <h1 class="title">{t.wall.title}</h1>
    <p class="prose">{t.wall.body}</p>

    <a class="button" href={localizedPath(locale, '/request/')}>
      <span>{t.wall.cta}</span>
      <span class="button-arrow" aria-hidden="true">→</span>
    </a>

    {/* No entries exist yet; the list goes here once the first one is published. */}
    <p class="label empty">{t.wall.empty}</p>
  </div>
</main>

<Footer locale={locale} />

<style>
  .wall {
    padding-block: clamp(4rem, 3rem + 6vw, 9rem);
  }

  .title {
    font-size: var(--step-5);
    margin-block: 1.5rem 1.25rem;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--line-strong);
    font-family: var(--font-display), var(--font-fallback-sans);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .button:hover {
    border-color: var(--patina);
    background-color: var(--surface);
  }

  .button-arrow {
    color: var(--patina);
    transition: transform 0.2s ease;
  }

  .button:hover .button-arrow {
    transform: translateX(0.35rem);
  }

  .empty {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
</style>
