---
import { LINKS, type Locale } from '../config.ts';
import { useTranslations } from '../i18n/utils.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="footer">
  <hr class="rule" />
  <div class="page footer-inner">
    <p class="label">{t.footer.built}</p>
    <a class="label footer-source" href={LINKS.repo}>{t.footer.source}</a>
  </div>
</footer>

<style>
  .footer {
    padding-bottom: 3rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-top: 1.5rem;
  }

  .footer-source {
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }

  .footer-source:hover {
    color: var(--text);
    border-bottom-color: var(--patina);
  }
</style>
