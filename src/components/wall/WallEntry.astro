---
import { type Locale, REPO } from '../../config.ts';
import { useTranslations } from '../../i18n/utils.ts';

/*
  The default frame for a wall entry: a card and a credit line. All of it is optional, down to
  using the frame at all; a contribution that wants to look or behave differently just does.
*/
interface Props {
  locale: Locale;
  /** GitHub login of the person who asked for the entry. Leave it off for an unsigned entry. */
  author?: string;
  /** Issue the request arrived as. */
  issue?: number;
  /** ISO date the request was filed. */
  date?: string;
  /** Columns out of six the entry takes on a wide screen, 6 by default. */
  span?: number;
}

const { locale, author, issue, date, span = 6 } = Astro.props;
const t = useTranslations(locale);

const issueUrl = issue ? `https://github.com/${REPO.owner}/${REPO.name}/issues/${issue}` : null;
const filed = date
  ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium' }).format(new Date(date))
  : null;
---

<li class="entry" style={`--span: ${span}`}>
  <slot />

  {
    (author || issueUrl || filed) && (
      <p class="credit">
        {author && (
          <span class="who">
            <span class="label prefix">{t.wall.entry.by}</span>
            <a class="handle" href={`https://github.com/${author}`}>@{author}</a>
          </span>
        )}
        {(issueUrl || filed) && (
          <span class="label meta">
            {issueUrl && <a href={issueUrl}>{t.wall.entry.request} #{issue}</a>}
            {filed && <time datetime={date}>{filed}</time>}
          </span>
        )}
      </p>
    )
  }
</li>

<style>
  .entry {
    /* The contribution fills against this to mask its own overlaps; it must match the card. */
    --entry-bg: var(--surface-raised);

    background-color: var(--entry-bg);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* Has to beat the run across the `·` inside .meta, or the widest gap falls within a group. */
    gap: 0.35rem 2.25rem;
    margin-top: 1.75rem;
  }

  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .prefix {
    color: var(--muted);
  }

  /* A person's handle is not an eyebrow: no uppercasing, no tracking, and it holds the text colour. */
  .handle {
    font-size: var(--step-0);
    color: var(--text);
    text-decoration-color: var(--patina);
  }

  .meta {
    display: flex;
    gap: 0.6rem;
    color: var(--muted);
  }

  .meta a {
    color: var(--patina);
  }

  /* Attached to the date, not a standalone span, so a wrap never strands the separator. */
  .meta a + time::before {
    content: '·';
    margin-inline-end: 0.6rem;
  }
</style>
