---
import Request from '../../components/Request.astro';
import { useTranslations } from '../../i18n/utils.ts';
import Layout from '../../layouts/Layout.astro';
import { handleRequest } from '../../lib/request-page.ts';

export const prerender = false;

const view = await handleRequest(Astro, 'ru');
if (view instanceof Response) return view;
const t = useTranslations('ru');
---

<Layout locale="ru" title={t.request.meta.title} description={t.request.meta.description} noIndex>
  <Request locale="ru" view={view} />
</Layout>
