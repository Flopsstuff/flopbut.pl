# Copy to .env (git-ignored). This is the one local secrets file: wrangler and `astro dev`
# read the worker's secrets from it, there is no .dev.vars. Push the same values to the
# repository secrets once with `gh secret set -f .env`.

# Cloudflare deploy.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# GitHub App behind the request form (docs/request-to-issue.md).
# GH_ rather than GITHUB_ because GitHub forbids that prefix for its secrets.
GH_APP_ID=
GH_APP_CLIENT_ID=
GH_APP_CLIENT_SECRET=
# openssl rand -hex 32
SESSION_SECRET=

# Contact endpoint (src/pages/api/contact.ts), dormant until all three are set.
TURNSTILE_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
