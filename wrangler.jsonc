{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flopbut-pl",

  // Astro's handler wrapped in a few lines that serve the crew page on agents.flopbut.pl.
  // Static pages are served straight from assets; the worker runs for routes that opted
  // out of prerendering and for the paths in `run_worker_first` below.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],

  // The adapter splits its output: prerendered pages into dist/client, the worker into
  // dist/server. After `astro build` wrangler follows the generated dist/client/wrangler.json
  // rather than this file, so treat the path below as documentation of the same layout.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The roots of each locale and the crew page under them. On agents.flopbut.pl the worker
    // answers the roots with the crew page; elsewhere it sends /agents/ to the subdomain.
    // Every other path stays a plain asset request with no worker invocation.
    "run_worker_first": ["/", "/ru/", "/pl/", "/agents/", "/ru/agents/", "/pl/agents/"]
  },

  "observability": {
    "enabled": true
  },

  // Kept on as a fallback while the apex settles; safe to set false afterwards.
  "workers_dev": true,

  // A plain route rather than `custom_domain`: the apex still carries leftover A records,
  // and Cloudflare refuses to attach a custom domain over externally managed DNS. Those
  // records are proxied, so the worker intercepts the request before any origin is reached.
  // Deleting them and switching to custom_domain is the tidier end state.
  // www is included because its CNAME resolves to the apex, whose leftover A records are
  // dead; without its own route it would 522. The canonical tag points at the apex, so
  // serving both hostnames does not create a duplicate in search results.
  "routes": [
    { "pattern": "flopbut.pl/*", "zone_name": "flopbut.pl" },
    { "pattern": "www.flopbut.pl/*", "zone_name": "flopbut.pl" },
    // The crew page. Its DNS record is a proxied AAAA 100:: placeholder: the worker answers
    // before any origin would be contacted. The subdomain also carries MX records for the
    // agents' mail, which this route does not touch.
    { "pattern": "agents.flopbut.pl/*", "zone_name": "flopbut.pl" }
  ]
}
